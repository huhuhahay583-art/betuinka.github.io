
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Website BETU | Teknologi Digital</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link 
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" 
        rel="stylesheet"
    >

    <!-- CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->
    <header class="header">

        <div class="logo">
            SOCIAL <span>MEDIA</span>
        </div>

        <nav class="navbar">
            <a href="#beranda" class="active">Beranda</a>
            <a href="#tentang">Tentang</a>
            <a href="#algoritma">Algoritma</a>
            <a href="#kontak">Kontak</a>
        </nav>

    </header>


    <!-- ================= HERO ================= -->
    <main>

        <section class="hero" id="beranda">

            <div class="hero-content">

                <span class="badge">
                    ✦ TEKNOLOGI DIGITAL
                </span>

                <h1>
                    Selamat Datang di
                    <span>Website BETU</span>
                </h1>

                <p>
                    Mari mengenal lebih jauh tentang algoritma
                    dan bagaimana teknologi digital bekerja
                    dalam kehidupan kita.
                </p>

                <div class="hero-buttons">

                    <a href="#algoritma" class="btn-primary">
                        Pelajari Algoritma
                        <span>→</span>
                    </a>

                    <a href="#tentang" class="btn-secondary">
                        Tentang Kami
                    </a>

                </div>

            </div>

            <!-- Dekorasi -->
            <div class="hero-decoration decoration-1"></div>
            <div class="hero-decoration decoration-2"></div>
            <div class="hero-decoration decoration-3"></div>

        </section>


        <!-- ================= TENTANG ================= -->
        <section class="about" id="tentang">

            <div class="section-title">
                <span>TENTANG</span>
                <h2>Apa Itu Algoritma?</h2>
                <p>
                    Algoritma merupakan bagian penting dalam teknologi
                    digital yang membantu menyelesaikan berbagai masalah.
                </p>
            </div>


            <div class="cards">

                <div class="card">
                    <div class="card-icon">01</div>

                    <h3>Terstruktur</h3>

                    <p>
                        Algoritma memiliki langkah-langkah yang
                        tersusun secara sistematis dan teratur.
                    </p>
                </div>


                <div class="card">
                    <div class="card-icon">02</div>

                    <h3>Efisien</h3>

                    <p>
                        Algoritma membantu menyelesaikan masalah
                        dengan cara yang lebih cepat dan efektif.
                    </p>
                </div>


                <div class="card">
                    <div class="card-icon">03</div>

                    <h3>Logis</h3>

                    <p>
                        Setiap langkah algoritma menggunakan
                        pemikiran logis untuk mendapatkan hasil.
                    </p>
                </div>

            </div>

        </section>


        <!-- ================= ALGORITMA ================= -->
        <section class="algorithm" id="algoritma">

            <div class="algorithm-box">

                <div class="algorithm-text">

                    <span class="small-title">
                        BELAJAR TEKNOLOGI
                    </span>

                    <h2>
                        Algoritma dalam
                        <span>Teknologi Digital</span>
                    </h2>

                    <p>
                        Algoritma digunakan dalam berbagai teknologi,
                        mulai dari mesin pencari, media sosial,
                        aplikasi, hingga kecerdasan buatan.
                    </p>

                    <a href="https://telkomuniversity.ac.id/apa-itu-algoritma-pengertian-ciri-ciri-jenis-dan-contohnya-dalam-kehidupan-sehari-hari/" class="learn-btn">
                        Mulai Belajar →
                    </a>

                </div>


                <div class="algorithm-visual">

                    <div class="code-card">

                        <div class="code-header">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <div class="code-content">
                            <p>
                                <b>01</b>
                                Mulai
                            </p>

                            <p>
                                <b>02</b>
                                Input Data
                            </p>

                            <p>
                                <b>03</b>
                                Proses Data
                            </p>

                            <p>
                                <b>04</b>
                                Tampilkan Hasil
                            </p>

                            <p>
                                <b>05</b>
                                Selesai
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================= KONTAK ================= -->
        <section class="contact" id="kontak">

            <div class="contact-content">

                <span>CONTACT</span>

                <h2>
                    Punya Pertanyaan?
                </h2>

                <p>
                    Jangan ragu untuk menghubungi kami
                    untuk mendapatkan informasi lebih lanjut.
                </p>

                <a href="fatrrntee@gmail.com" class="contact-btn">
                    Hubungi Kami →
                </a>

            </div>

        </section>

    </main>


    <!-- ================= INSTAGRAM ================= -->
    <a href="https://instagram.com/theftrhmn_" class="instagram" aria-label="Instagram">

        <div class="instagram-camera">

            <div class="instagram-lens"></div>

            <div class="instagram-dot"></div>

        </div>

    </a>


    <!-- ================= FOOTER ================= -->
    <footer class="footer">

        <div class="footer-content">

            <div>
                <strong>WEBSITE BETU</strong>

                <p>
                    Belajar teknologi digital dengan mudah.
                </p>
            </div>


            <div class="footer-links">

                <a href="#beranda">Beranda</a>
                <a href="#tentang">Tentang</a>
                <a href="#algoritma">Algoritma</a>
                <a href="#kontak">Kontak</a>

            </div>

        </div>


        <div class="copyright">
            © 2026 Website BETU. All Rights Reserved.
        </div>

    </footer>

</body>
</html>
